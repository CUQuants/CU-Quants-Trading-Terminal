# ---------------------------------------------------------------------------
# CU Quants Trading Terminal — server settings
# ---------------------------------------------------------------------------
# There are NO trader credentials in here. Each trader signs in from the
# browser with their own gateway operator credential — the four `proxy:`
# values in their xlrts config.yaml (api_key, api_secret, operator_id,
# operator_name). The server holds a trader's secret in memory only, for as
# long as they stay signed in.

# Where the CU Quants Trading Gateway is. Locally, the public gateway URL; on
# the gateway's own box, the loopback http://127.0.0.1:8080.
CUQ_PROXY_URL=https://your-gateway-host.example

# Optional: explicit wss:// base. Leave unset to derive it from CUQ_PROXY_URL
# (keeps the REST and WS bases from drifting apart).
# CUQ_PROXY_WS_URL=

# Simulated vs. live is NOT set here — it's a property of the gateway
# CUQ_PROXY_URL points at (OKX_SIMULATED on that gateway).

# Optional: audit-reporting API (trading-gateway/proxy_admin.reporting).
# Signed with the signed-in trader's own credential. Leave unset and the
# Reporting tab returns 503.
# CUQ_REPORTING_URL=https://your-reporting-host.example

# ---------------------------------------------------------------------------
# Sign-in sessions
# ---------------------------------------------------------------------------
# Mark the session cookie Secure (HTTPS only). Leave true in production; set
# false only for plain-http local dev (scripts/dev-local.sh does this).
# TERMINAL_COOKIE_SECURE=true

# Sign a trader out after this many hours idle, and after this many hours
# regardless.
# TERMINAL_SESSION_IDLE_HOURS=12
# TERMINAL_SESSION_MAX_HOURS=24

# Extra browser origins allowed to call the API, comma-separated. Normally
# empty: the browser reaches the API same-origin (Caddy in production, the
# Vite proxy in dev), and same-origin is always allowed.
# TERMINAL_ALLOWED_ORIGINS=
