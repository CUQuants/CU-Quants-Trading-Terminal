# ---------------------------------------------------------------------------
# CU Quants Proxy — the terminal's only OKX credential
# ---------------------------------------------------------------------------
# The terminal holds no OKX keys. Every OKX call goes through the CU Quants
# Trading Gateway ("the Proxy"), which holds the club's vaulted OKX key.
# Ask the club liaison for an OPERATOR credential (trading-gateway/NEW-USER.md).

CUQ_PROXY_URL=https://your-gateway-host.example
CUQ_PROXY_API_KEY=cuq_op_...
CUQ_PROXY_SECRET=
CUQ_PROXY_OPERATOR_ID=cuq-000
CUQ_PROXY_OPERATOR_NAME=Your Name

# Optional: explicit wss:// base. Leave unset to derive it from CUQ_PROXY_URL
# (keeps the REST and WS bases from drifting apart).
# CUQ_PROXY_WS_URL=

# Simulated vs. live is NOT set here any more — it's a property of the
# gateway CUQ_PROXY_URL points at (OKX_SIMULATED on that gateway). To test
# against OKX's simulated environment, point at a gateway running in that
# mode.

# ---------------------------------------------------------------------------
# Kraken — still called directly until its own migration
# ---------------------------------------------------------------------------
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
