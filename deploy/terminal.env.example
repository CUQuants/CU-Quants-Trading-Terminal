# /srv/cuq-terminal/.env on 178.105.55.5 — mode 600, admin-owned.
# No trader credentials belong here: traders sign in from the browser.

# The gateway on this same box, over loopback. The signed path (/v1/...) is
# the same as through Caddy, so signatures verify identically.
CUQ_PROXY_URL=http://127.0.0.1:8080

# Order-event streams: the gateway's public wss:// base is not needed — the
# WS base is derived from CUQ_PROXY_URL (ws://127.0.0.1:8080).
# CUQ_PROXY_WS_URL=

# Only if proxy_admin.reporting is ever deployed (it isn't today; the
# Reporting tab answers 503 until then).
# CUQ_REPORTING_URL=http://127.0.0.1:8090

# HTTPS in production: keep the session cookie Secure.
TERMINAL_COOKIE_SECURE=true
TERMINAL_SESSION_IDLE_HOURS=12
TERMINAL_SESSION_MAX_HOURS=24
